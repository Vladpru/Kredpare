# Copy to .env and fill in locally. Never commit .env. No values in this file.

# Postgres (docker compose service "postgres")
DATABASE_URL=

# Redis: Celery broker and result backend
REDIS_URL=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Gemini API key (OpenAI-compatible endpoint) for the workflow LLM level
# (docs/adr/0011-gemini-for-workflow-llm.md)
GEMINI_API_KEY=
